# Copy to .env and fill in. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: sqlite (default, dev) or postgres (VPS)
DB_ENGINE=sqlite
POSTGRES_DB=texas_news
POSTGRES_USER=texas_news
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Claude API
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-haiku-4-5
GENERATION_MODEL=claude-sonnet-5

# Pipeline tuning
GENERATION_THRESHOLD=12
GENERATE_REEL_SCRIPT=false
# Delete stories, images and run logs older than this many days (runs inside run_pipeline)
RETENTION_DAYS=30
