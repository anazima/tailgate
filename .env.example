# Copy to .env and fill in. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Production: CSRF_TRUSTED_ORIGINS=https://tailgate.retoph.com
CSRF_TRUSTED_ORIGINS=

# Database: sqlite (default, dev) or postgres (VPS)
DB_ENGINE=sqlite
POSTGRES_DB=texas_news
POSTGRES_USER=texas_news
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Claude API
ANTHROPIC_API_KEY=
# Stage 1 triage and stage 3 ranking (cheap, headline-level)
SCORING_MODEL=claude-haiku-4-5
TRIAGE_MODEL=claude-haiku-4-5
# Stage 2 deep read: reads the article and does the real scoring
DEEP_READ_MODEL=claude-sonnet-5
GENERATION_MODEL=claude-sonnet-5

# Pipeline tuning
# How many of the top-ranked stories get post text written each run
GENERATION_TOP_N=10
GENERATE_REEL_SCRIPT=false

# Deep read: articles are fetched, cut to this many words, scored, and NOT stored
ARTICLE_MAX_WORDS=500
ARTICLE_FETCH_WORKERS=8
# Caps what one hourly run can spend on an unusual news day
DEEP_READ_BATCH_SIZE=6
DEEP_READ_MAX_PER_RUN=15
# Triaged stories older than this are past their shelf life and never retried
DEEP_READ_MAX_AGE_HOURS=48
# Stage 3 ranks recent stories against each other over this sliding window
RANK_WINDOW_HOURS=24
# Delete stories, images and run logs older than this many days (runs inside run_pipeline)
RETENTION_DAYS=30

# Browser push notifications (optional). Generate with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=you@example.com
